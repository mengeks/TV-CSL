{
  "R": 1000,
  "K": 5,
  "datagen": {
    "is_time_varying": true,
    "light_censoring": false,
    "lambda_C": 0.1,
    "p": 3,
    "X_distribution": "normal",
    "X_cov_type": "identity",
    "tx_difficulty": "simple",
    "linear_HTE_multiplier": 1,
    "linear_intercept": 0,
    "linear_slope_multiplier": 2.5
  },
  "methods": {
    "cox": {
      "enabled": false,
      "run_time_varying": [true],
      "model_specifications": ["correctly-specified"]
    },
    "s_cox": {
      "enabled": true,
      "regressor_specs": ["linear", "complex"],
      "HTE_specs": ["linear"]
    },
    "lasso": {
      "enabled": true,
      "regressor_specs": ["linear", "complex"],
      "lasso_types": ["S-lasso"],
      "HTE_specs": ["linear"]
    },
    "TV_CSL": {
      "enabled": true,
      "prop_score_specs": [
        "cox-linear-censored-only",
        "cox-intercept-only",
        "cox-risk-set-adjusted"
      ],
      "regressor_specs": ["linear", "complex"],
      "lasso_types": ["S-lasso"],
      "HTE_specs": ["linear"],
      "final_model_methods": ["lasso_coxph"]
    }
  }
}
